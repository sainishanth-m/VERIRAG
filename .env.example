# ==============================================================================
# VeriRag Environment Configuration (Stateless / Vercel Serverless)
# ==============================================================================

# Primary LLM & Embedding Provider (Google AI Studio)
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_LLM_MODEL=gemini-2.5-flash
GOOGLE_LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Optional AgentRouter backup (set LLM_PROVIDER=agentrouter or enable fallback)
LLM_AGENTROUTER_FALLBACK_ENABLED=false
# AGENTROUTER_API_KEY=your_agentrouter_api_key_here
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=deepseek-v4-flash

# Request timeouts
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=45

# Optional local dev server settings (not needed on Vercel)
FRONTEND_URL=http://localhost:5173
PORT=8000
